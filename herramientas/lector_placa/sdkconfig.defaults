# Placa ESP32-S3 N16R8 (16 MB de flash)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Red por USB: el PC ve la placa como tarjeta de red (NCM, sin drivers)
CONFIG_TINYUSB_NET_MODE_NCM=y
# Teclado USB: abre la página sola al enchufar
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_TASK_AFFINITY_CPU0=y
CONFIG_TINYUSB_INIT_IN_DEFAULT_TASK=y
# Mensajes por el puerto "COM" (UART), así el puerto "USB" queda libre para la red
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# Bluetooth (BLE): el lector busca el teléfono y se conecta (rol central)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Memoria externa (8 MB) para la ficha
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y
# Cifrado igual al Lector del PC (X25519 + HKDF-SHA256 + AES-256-GCM)
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=y
# Programa más grande (Bluetooth + red + página)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Si un programa nuevo no arranca bien, vuelve solo al anterior
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
